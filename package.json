{
  "name": "nexus-discord-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Discord-Bot für Tickets, Buy-Panels, Giveaways, Vouches und /pay-Zahlungsanfragen",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "bot"
  ],
  "scripts": {
    "start": "node index.js",
    "bot": "node index.js",
